# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Configuration
DATABASE_URL="./data/vle_database.json"

# Payment Gateway Configuration (bKash / Nagad / SSLCommerz / Generic Gateway)
PAYMENT_GATEWAY_KEY="your_payment_gateway_api_key_here"
PAYMENT_GATEWAY_SECRET="your_payment_gateway_api_secret_here"
WEBHOOK_SECRET="your_payment_webhook_hmac_secret_here"

# VLE Player Future Integration Settings
VLE_API_URL="https://api.vleplayer.internal/v1"
VLE_API_SECRET="your_vle_player_api_secret_here"

# Admin Authentication Secret (Used for signing admin JWT sessions)
ADMIN_SECRET="your_secure_random_admin_secret_minimum_32_characters"
ADMIN_DEFAULT_PASSWORD="admin_change_this_immediately"
